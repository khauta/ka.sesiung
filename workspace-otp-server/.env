PORT=3000
NODE_ENV=development

# JSON Web Token Secret (Change to a secure random string in production)
JWT_SECRET=super_secret_workspace_key_2026

# Shared secret for the /api/internal/sync-clients endpoint.
# The Google Apps Script caller must send this in the X-Internal-Token header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=change_me_to_a_random_secret

# Allowed frontend origin for CORS. Set to your deployed PWA URL in production.
# Leave unset (or use *) only in development.
CORS_ORIGIN=http://localhost:5173

# Router 1 Config (Primary)
ROUTER_1_IP=192.168.8.1
ROUTER_USER=admin
ROUTER_PASS=Technomath

# Router 2 Config (Failover)
ROUTER_2_IP=192.168.9.1
