PORT=3000
NODE_ENV=development

# JSON Web Token Secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Shared secret for the /api/internal/sync-clients endpoint.
# The Google Apps Script caller must include the header X-Internal-Token: <value>.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=

# Allowed frontend origin for CORS (e.g. https://ka-sesiung.web.app).
# Use * only in development.
CORS_ORIGIN=http://localhost:5173

# Huawei SMS router configuration (production only)
ROUTER_1_IP=192.168.8.1
ROUTER_USER=admin
ROUTER_PASS=

ROUTER_2_IP=192.168.9.1
