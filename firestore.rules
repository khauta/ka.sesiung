rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sameClient(clientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaceUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/workspaceUsers/$(request.auth.uid)).data.clientId == clientId;
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /workspaceUsers/{phone} {
      allow read: if signedIn() && request.auth.uid == phone;
      allow write: if false;
    }

    match /clients/{clientId} {
      allow read: if sameClient(clientId);
      allow write: if false;

      match /resources/{resourceId} {
        allow read: if sameClient(clientId);
        allow write: if false;
      }

      match /documents/{documentId} {
        allow read: if sameClient(clientId);
        allow write: if false;
      }
    }
  }
}
