# Frontend environment variables — copy to .env.local for local development
# Vite exposes only variables prefixed with VITE_ to browser code.

# Base URL of the workspace-otp-server.
# During local development this is typically http://localhost:3000.
# In production set it to the server's public URL (e.g. via Tailscale or a VPS).
VITE_OTP_SERVER_URL=http://localhost:3000
